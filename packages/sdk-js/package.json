{
  "name": "@r3fstudio/jynx-sdk",
  "version": "0.0.2",
  "description": "JavaScript and TypeScript clients for Jynx model APIs and the Jynx Harness",
  "type": "module",
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE",
    "COPYRIGHT",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./discovery": {
      "types": "./types/discovery.d.ts",
      "default": "./src/discovery/node.js"
    },
    "./harness": {
      "types": "./types/harness.d.ts",
      "default": "./src/harness/client.js"
    }
  },
  "scripts": {
    "build": "node --test test/*.test.js",
    "test": "node --test test/*.test.js",
    "prepack": "node ../../scripts/privacy-assets.mjs"
  },
  "license": "GPL-3.0-only",
  "author": "R3F Studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/R3FStudio/Jynx.git",
    "directory": "packages/sdk-js"
  },
  "homepage": "https://github.com/R3FStudio/Jynx/blob/main/docs/reference/sdks.md",
  "bugs": {
    "url": "https://github.com/R3FStudio/Jynx/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "jynx",
    "coding-agent",
    "llm",
    "sdk",
    "mcp"
  ]
}
