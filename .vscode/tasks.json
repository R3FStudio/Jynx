{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Harness: build (debug)",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--manifest-path", "packages/harness/Cargo.toml", "-p", "jynx-server", "--bin", "jynx-harness"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$rustc"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Harness: check",
      "type": "process",
      "command": "cargo",
