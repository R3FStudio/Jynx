{
  "name": "jynx-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "Jynx CLI, agent harness, and SDKs for working with local and remote models.",
  "type": "module",
  "author": "R3F Studio",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/R3FStudio/Jynx.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/harness",
    "packages/cli",
    "packages/sdk-js",
    "packages/sdk-python",
    "tools/tooling"
  ],
  "scripts": {
    "start:desktop": "npm run start --prefix packages/private/Desktop --workspaces=false",
    "start:electron": "npm run start:desktop",
    "start:harness": "npm run start --workspace @jynx/harness",
    "start:cli": "npm run start --workspace @jynx/cli",
    "start:llama": "node scripts/start-llama.ts",
    "start:llama-harness": "node scripts/start-llama-harness.ts",
    "dev": "npm run dev --prefix packages/private/Desktop --workspaces=false",
    "build": "node scripts/build-all.ts",
    "doctor": "node tools/repo-doctor.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "build:harness": "npm run build --workspace @jynx/harness",
    "build:main": "npm run build:main --prefix packages/private/Desktop --workspaces=false",
    "build:renderer": "npm run build:renderer --prefix packages/private/Desktop --workspaces=false",
    "typecheck": "npm run typecheck --prefix packages/private/Desktop --workspaces=false",
    "format": "node tools/tooling/run.mjs format",
    "format:check": "node tools/tooling/run.mjs format:check",
    "lint": "node tools/tooling/run.mjs lint",
    "dist": "node scripts/pack-all.ts --installers-only",
    "pack": "node scripts/pack-all.ts --bundle-only",
    "pack:desktop": "node scripts/pack-all.ts --desktop-only --dir",
    "package:desktop": "node scripts/pack-all.ts --desktop-only",
    "installer": "node scripts/pack-all.ts --installers-only",
    "installer:dir": "node scripts/pack-all.ts --bundle-only",
    "clean": "node scripts/clean-artifacts.ts",
    "llama:sync": "node scripts/sync-llama.ts",
    "harness:build": "npm run build:harness",
    "harness:check": "npm run check --workspace @jynx/harness",
    "sdk:test:js": "npm run test --workspace @jynx/sdk",
    "sdk:test:python": "npm run test --workspace @jynx/sdk-python",
    "sdk:test": "npm run sdk:test:js && npm run sdk:test:python",
    "build:all": "node scripts/build-all.ts",
    "build:desktop": "npm run build --prefix packages/private/Desktop --workspaces=false",
    "build:cli": "npm run build --workspace @jynx/cli",
    "build:sdk": "npm run build --workspace @jynx/sdk && npm run build --workspace @jynx/sdk-python",
    "cli:check": "npm run check --workspace @jynx/cli",
    "pack:harness": "npm run build:harness && node scripts/pack-native.ts harness",
    "pack:cli": "npm run build:cli && node scripts/pack-native.ts cli",
    "pack:llama": "node scripts/pack-llama.ts",
    "pack:sdk-js": "node scripts/pack-sdk-js.ts",
    "pack:sdk-python": "node packages/sdk-python/scripts/build-wheel.mjs",
    "pack:all": "node scripts/pack-all.ts",
    "sync:llama": "npm run llama:sync",
    "repo:setup": "node scripts/repositories.mjs setup",
    "repo:status": "node scripts/repositories.mjs status",
    "repo:commit": "node scripts/repositories.mjs commit",
    "repo:push": "node scripts/repositories.mjs push",
    "repo:sync": "node scripts/repositories.mjs sync",
    "build:all:exclude-desktop": "node scripts/build-all.ts --exclude-desktop",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "docs:check": "node scripts/check-docs.mjs",
    "desktop:clone": "node scripts/repositories.mjs clone desktop",
    "pack:bundle": "node scripts/pack-all.ts --bundle-only",
    "package:installers": "node scripts/pack-all.ts --installers-only",
    "pack:public": "node scripts/pack-all.ts --exclude-desktop",
    "pack:all:with-desktop": "node scripts/pack-all.ts --include-desktop",
    "pack:installers": "node scripts/pack-all.ts --installers-only",
    "pack:all:exclude-desktop": "node scripts/pack-all.ts --exclude-desktop",
    "package:installers:exclude-desktop": "node scripts/pack-all.ts --installers-only --exclude-desktop",
    "pack:bundle:exclude-desktop": "node scripts/pack-all.ts --bundle-only --exclude-desktop"
  },
  "devDependencies": {
    "tar": "7.5.22"
  }
}
